generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AuditLog {
  id           String        @id @default(cuid())
  userId       String
  actionType   ActionType
  entityType   String
  entityId     String
  beforeData   Json?
  afterData    Json?
  timestamp    DateTime      @default(now())
  ipAddress    String?
  changes      Json?
  description  String        @default("")
  errorMessage String?
  metadata     Json?
  severity     AuditSeverity @default(LOW)
  success      Boolean       @default(true)
  userAgent    String?
  user         User          @relation("AuditLogs", fields: [userId], references: [id])

  @@index([actionType])
  @@index([entityType, entityId])
  @@index([severity])
  @@index([timestamp])
  @@index([userId])
}

model Currency {
  id                         String                       @id
  code                       String                       @unique
  name                       String
  symbol                     String
  isBase                     Boolean                      @default(false)
  isActive                   Boolean                      @default(true)
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime
  organisationBaseCurrencies OrganisationBaseCurrency[]
  exchangeRates              ExchangeRate[]               @relation("FromCurrency")
  reverseRates               ExchangeRate[]               @relation("ToCurrency")
  transactions               Transaction[]
  users                      User[]

  @@index([code])
  @@index([isActive])
}

/// Organisation unit in the hierarchy:
/// HQ (DENOMINATION) → Oversight → Campus → Account (COUNCIL).
model Organisation {
  id                       String                     @id
  name                     String
  level                    OrganisationLevel?
  /// Only set when level is COUNCIL (Account). OPERATING holds a balance;
  /// SPECIAL_PROJECT is expense-only with no balance.
  accountType              AccountType?
  parentId                 String?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime
  closedAt                 DateTime?
  closedBy                 String?
  closureReason            String?
  isActive                 Boolean                    @default(true)
  publicFormEnabled        Boolean                    @default(true)
  parent                   Organisation?              @relation("OrganisationHierarchy", fields: [parentId], references: [id])
  children                 Organisation[]             @relation("OrganisationHierarchy")
  organisationBaseCurrency OrganisationBaseCurrency?
  transactions             Transaction[]
  users                    User[]
  userRoles                UserRole[]
  publicExpenseRequests    PublicExpenseRequest[]     @relation("CampusPublicRequests")

  @@index([isActive])
  @@index([level])
  @@index([parentId])
  @@index([accountType])
}

model OrganisationBaseCurrency {
  id             String       @id
  organisationId String       @unique
  currencyId     String
  setBy          String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  currency       Currency     @relation(fields: [currencyId], references: [id])
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  setByUser      User         @relation("OrganisationBaseCurrenciesSet", fields: [setBy], references: [id])

  @@index([currencyId])
  @@index([organisationId])
}

model ExchangeRate {
  id             String   @id
  fromCurrencyId String
  toCurrencyId   String
  rate           Decimal
  effectiveDate  DateTime @default(now())
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime
  fromCurrency   Currency @relation("FromCurrency", fields: [fromCurrencyId], references: [id])
  toCurrency     Currency @relation("ToCurrency", fields: [toCurrencyId], references: [id])

  @@unique([fromCurrencyId, toCurrencyId])
  @@index([effectiveDate])
  @@index([fromCurrencyId])
  @@index([toCurrencyId])
}

model File {
  id            String      @id
  transactionId String      @unique
  fileName      String
  fileUrl       String
  fileMime      String
  fileSize      Int?
  uploadedBy    String
  uploadedAt    DateTime    @default(now())
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  uploader      User        @relation("FileUploads", fields: [uploadedBy], references: [id])

  @@index([uploadedBy])
}

model PasswordReset {
  id        String    @id
  userId    String
  token     String    @unique
  expiresAt DateTime
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation("PasswordResets", fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([token])
  @@index([userId])
}

model SmsTemplate {
  id          String   @id
  key         String   @unique
  name        String
  description String?
  template    String
  variables   String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([key])
}

model Transaction {
  id                   String                 @id
  organisationId       String
  userId               String
  type                 TransactionType
  amount               Decimal                @db.Decimal(14, 2)
  description          String
  weekNumber           Int
  year                 Int
  locked               Boolean                @default(false)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  approvedAt           DateTime?
  approvedBy           String?
  status               TransactionStatus      @default(PENDING)
  amountInBase         Decimal?               @db.Decimal(14, 2)
  currencyId           String?
  exchangeRate         Decimal?
  rejectedAt           DateTime?
  rejectedBy           String?
  rejectionReason      String?
  requestedAmount      Decimal?               @db.Decimal(14, 2)
  isCharge             Boolean                @default(false)
  receiptWaived        Boolean                @default(false)
  receiptWaivedAt      DateTime?
  receiptWaivedBy      String?
  receiptWaivedReason  String?
  /// Shared by the two legs of an account-to-account transfer, so the debit and
  /// credit are provably one movement rather than two coincidental entries.
  transferId           String?
  transferDirection    TransferDirection?
  files                File[]
  currency             Currency?              @relation(fields: [currencyId], references: [id])
  organisation         Organisation           @relation(fields: [organisationId], references: [id])
  user                 User                   @relation("Transactions", fields: [userId], references: [id])
  receiptWaivedByUser  User?                  @relation("ReceiptWaivedBy", fields: [receiptWaivedBy], references: [id])
  publicExpenseRequest PublicExpenseRequest?  @relation("PublicExpenseTransaction")

  @@index([createdAt])
  @@index([currencyId])
  @@index([organisationId])
  @@index([organisationId, status, type])
  @@index([status])
  @@index([type])
  @@index([userId])
  @@index([transferId])
}

model User {
  id                            String                     @id
  name                          String?
  email                         String                     @unique
  password                      String?
  image                         String?
  organisationId                String?
  createdAt                     DateTime                   @default(now())
  updatedAt                     DateTime
  archived                      Boolean                    @default(false)
  baseCurrencyId                String?
  activeRole                    Role?
  activeUserRoleId              String?
  title                         String?
  phone                         String                     @unique
  auditLogs                     AuditLog[]                 @relation("AuditLogs")
  organisationBaseCurrenciesSet OrganisationBaseCurrency[] @relation("OrganisationBaseCurrenciesSet")
  passwordResets                PasswordReset[]            @relation("PasswordResets")
  transactions                  Transaction[]              @relation("Transactions")
  fileUploads                   File[]                     @relation("FileUploads")
  receiptWaivers                Transaction[]              @relation("ReceiptWaivedBy")
  activeUserRole                UserRole?                  @relation("ActiveUserRole", fields: [activeUserRoleId], references: [id])
  baseCurrency                  Currency?                  @relation(fields: [baseCurrencyId], references: [id])
  organisation                  Organisation?              @relation(fields: [organisationId], references: [id])
  userRoles                     UserRole[]                 @relation("UserRoles")

  @@index([activeUserRoleId])
  @@index([archived])
  @@index([baseCurrencyId])
}

model UserRole {
  id             String        @id
  userId         String
  role           Role?
  organisationId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  activeUsers    User[]        @relation("ActiveUserRole")
  organisation   Organisation  @relation(fields: [organisationId], references: [id])
  user           User          @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role, organisationId])
  @@index([organisationId])
  @@index([role])
  @@index([userId])
}

enum ActionType {
  CREATE
  UPDATE
  DELETE
  LOGIN
  ROLE_CHANGE
  LOCK_OVERRIDE
  FILE_UPLOAD
  LOGOUT
  APPROVE
  REJECT
  ARCHIVE
  RESTORE
  TRANSFER
  RECALCULATE
  IMPERSONATE
  STOP_IMPERSONATION
  RECEIPT_WAIVED
}

/// Which leg of a transfer a transaction represents. OUT is the debit on the
/// source account, IN the matching credit on the destination.
enum TransferDirection {
  OUT
  IN
}

enum AuditSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum OrganisationLevel {
  DENOMINATION
  OVERSIGHT
  CAMPUS
  /// Deprecated — kept for existing rows until data migration collapses streams.
  STREAM
  /// Product name: Account (money-bearing leaf).
  COUNCIL
}

/// Account kinds. Only meaningful when Organisation.level is COUNCIL.
enum AccountType {
  OPERATING
  SPECIAL_PROJECT
}

enum Role {
  SUPERADMIN
  DENOMINATION_ADMIN
  DENOMINATION_LEADER
  OVERSIGHT_ADMIN
  OVERSIGHT_LEADER
  CAMPUS_ADMIN
  CAMPUS_LEADER
  STREAM_ADMIN
  STREAM_LEADER
  COUNCIL_ADMIN
  COUNCIL_LEADER
}

enum TransactionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransactionType {
  INCOME
  EXPENSE
}

model PublicExpenseRequest {
  id                   String                     @id @default(uuid())
  requesterName        String
  churchName           String
  momoName             String
  momoNumber           String
  leaderPhone          String?
  amount               Decimal                    @db.Decimal(14, 2)
  description          String
  status               PublicExpenseRequestStatus @default(PENDING)
  campusOrganisationId String
  transactionId        String?                    @unique
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime

  campusOrganisation Organisation  @relation("CampusPublicRequests", fields: [campusOrganisationId], references: [id])
  transaction        Transaction?  @relation("PublicExpenseTransaction", fields: [transactionId], references: [id])

  @@index([campusOrganisationId])
  @@index([status])
}

enum PublicExpenseRequestStatus {
  PENDING
  PROCESSED
  REJECTED
}
