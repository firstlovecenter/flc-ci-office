generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AuditLog {
  id           String        @id @default(cuid())
  userId       String
  actionType   ActionType
  entityType   String
  entityId     String
  beforeData   Json?
  afterData    Json?
  timestamp    DateTime      @default(now())
  ipAddress    String?
  changes      Json?
  description  String        @default("")
  errorMessage String?
  metadata     Json?
  severity     AuditSeverity @default(LOW)
  success      Boolean       @default(true)
  userAgent    String?
    user         User          @relation("AuditLogs", fields: [userId], references: [id])

  @@index([actionType])
  @@index([entityType, entityId])
  @@index([severity])
  @@index([timestamp])
  @@index([userId])
}

model Currency {
  id                                                 String                   @id
  code                                               String                   @unique
  name                                               String
  symbol                                             String
  isBase                                             Boolean                  @default(false)
  isActive                                           Boolean                  @default(true)
  createdAt                                          DateTime                 @default(now())
  updatedAt                                          DateTime
    departmentBaseCurrencies                           DepartmentBaseCurrency[]
    exchangeRates                                      ExchangeRate[]           @relation("FromCurrency")
    reverseRates                                       ExchangeRate[]           @relation("ToCurrency")
    transactions                                       Transaction[]
    users                                              User[]

  @@index([code])
  @@index([isActive])
}

model Department {
  id                     String                  @id
  name                   String
  level                  DepartmentLevel?
  parentId               String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime
  closedAt               DateTime?
  closedBy               String?
  closureReason          String?
  isActive               Boolean                 @default(true)
  publicFormEnabled      Boolean                 @default(true)
    parent                 Department?             @relation("DepartmentHierarchy", fields: [parentId], references: [id])
    children               Department[]            @relation("DepartmentHierarchy")
    departmentBaseCurrency DepartmentBaseCurrency?
    transactions           Transaction[]
    users                  User[]
    userRoles              UserRole[]
    publicExpenseRequests  PublicExpenseRequest[]  @relation("OversightPublicRequests")

  @@index([isActive])
  @@index([level])
  @@index([parentId])
}

model DepartmentBaseCurrency {
  id           String     @id
  departmentId String     @unique
  currencyId   String
  setBy        String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime
    currency     Currency   @relation(fields: [currencyId], references: [id])
    department   Department @relation(fields: [departmentId], references: [id])
    setByUser    User       @relation("DepartmentBaseCurrenciesSet", fields: [setBy], references: [id])

  @@index([currencyId])
  @@index([departmentId])
}

model ExchangeRate {
  id                                             String   @id
  fromCurrencyId                                 String
  toCurrencyId                                   String
  rate                                           Decimal
  effectiveDate                                  DateTime @default(now())
  createdBy                                      String
  createdAt                                      DateTime @default(now())
  updatedAt                                      DateTime
    fromCurrency                                   Currency @relation("FromCurrency", fields: [fromCurrencyId], references: [id])
    toCurrency                                     Currency @relation("ToCurrency", fields: [toCurrencyId], references: [id])

  @@unique([fromCurrencyId, toCurrencyId])
  @@index([effectiveDate])
  @@index([fromCurrencyId])
  @@index([toCurrencyId])
}

model File {
  id            String      @id
  transactionId String      @unique
  fileName      String
  fileUrl       String
  fileMime      String
  fileSize      Int?
  uploadedBy    String
  uploadedAt    DateTime    @default(now())
    transaction   Transaction @relation(fields: [transactionId], references: [id])
    uploader      User        @relation("FileUploads", fields: [uploadedBy], references: [id])

  @@index([uploadedBy])
}

model PasswordReset {
  id        String    @id
  userId    String
  token     String    @unique
  expiresAt DateTime
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
    user      User      @relation("PasswordResets", fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([token])
  @@index([userId])
}

model SmsTemplate {
  id          String   @id
  key         String   @unique
  name        String
  description String?
  template    String
  variables   String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([key])
}

model Transaction {
  id              String            @id
  departmentId    String
  userId          String
  type            TransactionType
  amount          Decimal           @db.Decimal(14, 2)
  description     String
  weekNumber      Int
  year            Int
  locked          Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  approvedAt      DateTime?
  approvedBy      String?
  status          TransactionStatus @default(PENDING)
  amountInBase    Decimal?          @db.Decimal(14, 2)
  currencyId      String?
  exchangeRate    Decimal?
  rejectedAt      DateTime?
  rejectedBy      String?
  rejectionReason String?
    files                File[]
    currency             Currency?         @relation(fields: [currencyId], references: [id])
    department           Department        @relation(fields: [departmentId], references: [id])
    user                 User              @relation("Transactions", fields: [userId], references: [id])
    publicExpenseRequest PublicExpenseRequest? @relation("PublicExpenseTransaction")

  @@index([createdAt])
  @@index([currencyId])
  @@index([departmentId])
  @@index([departmentId, status, type])
  @@index([status])
  @@index([type])
  @@index([userId])
}

model User {
  id                                       String                   @id
  name                                     String?
  email                                    String                   @unique
  password                                 String?
  image                                    String?
  departmentId                             String?
  createdAt                                DateTime                 @default(now())
  updatedAt                                DateTime
  archived                                 Boolean                  @default(false)
  baseCurrencyId                           String?
  activeRole                               Role?
  activeUserRoleId                         String?
  title                                    String?
  phone                                    String                   @unique
    auditLogs                                AuditLog[]               @relation("AuditLogs")
    departmentBaseCurrenciesSet              DepartmentBaseCurrency[] @relation("DepartmentBaseCurrenciesSet")
    passwordResets                           PasswordReset[]          @relation("PasswordResets")
    transactions                             Transaction[]            @relation("Transactions")
    fileUploads                              File[]                   @relation("FileUploads")
    activeUserRole                           UserRole?                @relation("ActiveUserRole", fields: [activeUserRoleId], references: [id])
    baseCurrency                             Currency?                @relation(fields: [baseCurrencyId], references: [id])
    department                               Department?              @relation(fields: [departmentId], references: [id])
    userRoles                                UserRole[]               @relation("UserRoles")

  @@index([activeUserRoleId])
  @@index([archived])
  @@index([baseCurrencyId])
}

model UserRole {
  id                                   String     @id
  userId                               String
  role                                 Role?
  departmentId                         String
  createdAt                            DateTime   @default(now())
  updatedAt                            DateTime
    activeUsers                          User[]     @relation("ActiveUserRole")
    department                           Department @relation(fields: [departmentId], references: [id])
    user                                 User       @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role, departmentId])
  @@index([departmentId])
  @@index([role])
  @@index([userId])
}

enum ActionType {
  CREATE
  UPDATE
  DELETE
  LOGIN
  ROLE_CHANGE
  LOCK_OVERRIDE
  FILE_UPLOAD
  LOGOUT
  APPROVE
  REJECT
  ARCHIVE
  RESTORE
  TRANSFER
  RECALCULATE
  IMPERSONATE
  STOP_IMPERSONATION
}

enum AuditSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DepartmentLevel {
  DENOMINATION
  OVERSIGHT
  CAMPUS
  STREAM
  COUNCIL
}

enum Role {
  SUPERADMIN
  DENOMINATION_ADMIN
  DENOMINATION_LEADER
  OVERSIGHT_ADMIN
  OVERSIGHT_LEADER
  CAMPUS_ADMIN
  CAMPUS_LEADER
  STREAM_ADMIN
  STREAM_LEADER
  COUNCIL_ADMIN
  COUNCIL_LEADER
}

enum TransactionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransactionType {
  INCOME
  EXPENSE
}

model PublicExpenseRequest {
  id              String                     @id @default(uuid())
  requesterName   String
  churchName      String
  momoName        String
  momoNumber      String
  leaderPhone     String?
  amount          Decimal                    @db.Decimal(14, 2)
  description     String
  status          PublicExpenseRequestStatus @default(PENDING)
  oversightDeptId String
  transactionId   String?                    @unique
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime

  oversightDept Department    @relation("OversightPublicRequests", fields: [oversightDeptId], references: [id])
  transaction   Transaction?  @relation("PublicExpenseTransaction", fields: [transactionId], references: [id])

  @@index([oversightDeptId])
  @@index([status])
}

enum PublicExpenseRequestStatus {
  PENDING
  PROCESSED
  REJECTED
}
