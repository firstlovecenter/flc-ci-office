{
    "name": "flc-ci-office",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "ci": "npm run type-check && npm run lint && npm run test",
        "db:seed": "node prisma/seed.js",
        "db:migrate": "prisma migrate dev",
        "prepare": "husky",
        "postinstall": "prisma generate"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,css}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/icons-material": "^7.3.8",
        "@mui/material": "^7.3.5",
        "@mui/material-nextjs": "^7.3.5",
        "@neondatabase/serverless": "^1.0.2",
        "@prisma/adapter-pg": "^7.0.0",
        "@prisma/client": "^7.0.0",
        "@types/bcryptjs": "^2.4.6",
        "axios": "^1.13.2",
        "bcrypt": "^6.0.0",
        "bcryptjs": "^3.0.3",
        "cloudinary": "^2.8.0",
        "critters": "^0.0.23",
        "date-fns": "^4.1.0",
        "dotenv": "^17.2.3",
        "next": "16.0.7",
        "next-auth": "^4.24.13",
        "pdf-lib": "^1.17.1",
        "pdfkit": "^0.17.2",
        "pg": "^8.16.3",
        "react": "19.2.0",
        "react-dom": "19.2.0",
        "recharts": "^3.4.1",
        "resend": "^6.9.3",
        "web-push": "^3.6.7"
    },
    "devDependencies": {
        "@ducanh2912/next-pwa": "^10.2.9",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/bcrypt": "^6.0.0",
        "@types/node": "^20",
        "@types/pdfkit": "^0.17.3",
        "@types/pg": "^8.15.6",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@types/web-push": "^3.6.4",
        "@vitejs/plugin-react": "^6.0.1",
        "@vitest/coverage-v8": "^4.1.0",
        "babel-plugin-react-compiler": "1.0.0",
        "baseline-browser-mapping": "^2.9.19",
        "eslint": "^9",
        "eslint-config-next": "16.0.3",
        "husky": "^9.1.7",
        "jsdom": "^29.0.0",
        "lint-staged": "^16.4.0",
        "msw": "^2.12.13",
        "prettier": "^3.8.1",
        "prisma": "^7.0.0",
        "ts-node": "^10.9.2",
        "tsx": "^4.20.6",
        "typescript": "^5",
        "vitest": "^4.1.0",
        "workbox-window": "^7.4.0"
    }
}
