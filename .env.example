# ── Required ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/dbname"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="https://your-domain.com"

# Email address allowed to hold the SUPERADMIN role.
# Only this account can be assigned SUPERADMIN in the system.
SUPERADMIN_EMAIL="admin@example.com"

# ── Optional: SMS (SMSOptics) ─────────────────────────────────────────────────
SMSOPTICS_API_KEY=""
SMSOPTICS_SENDER_ID=""

# ── Optional: Email (Resend) ──────────────────────────────────────────────────
RESEND_API_KEY=""

# ── Optional: Push Notifications (Web Push / VAPID) ──────────────────────────
# Generate keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@your-domain.com"

# ── Optional: Cron ────────────────────────────────────────────────────────────
# Secret sent in Authorization header for scheduled cron jobs
CRON_SECRET=""
